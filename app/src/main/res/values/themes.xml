<resources>
    <!-- Compose owns the visuals; this base theme only sets the pre-Compose window background
         (light here, dark in values-night) for a calm cold start. -->
    <style name="Theme.Translate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F4FBFA</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Activity that hosts the widget's dialog-style search popup. Translucent so the home
         screen stays visible underneath; Compose draws the floating card and handles the dim. -->
    <style name="Theme.Translate.QuickSearch" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
