<?xml version="1.0" encoding="utf-8"?>
<!--
   The bundled dictionary.db (hundreds of MB) is copied out of the APK on first launch and is
   fully regenerable, so it must never be backed up or transferred. Only user.db (recents/stats)
   should travel with the user. Used on Android 12+ (API 31+).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="dictionary.db" />
        <exclude domain="database" path="dictionary.version" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dictionary.db" />
        <exclude domain="database" path="dictionary.version" />
    </device-transfer>
</data-extraction-rules>
