<?xml version="1.0" encoding="utf-8"?>
<!--
  Open-book mark, perfectly symmetric about the vertical center (x=54). Gold pages on the black
  adaptive background, a darker fold at the spine, and three text lines per page that tilt toward
  the fold. All geometry stays inside the ~66dp safe circle (center 54,54; every corner within
  radius ≈34), so no mask shape clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left page -->
    <path
        android:fillColor="#D4B062"
        android:pathData="M54,45 C45,40 34,38.5 23,41 L23,67 C34,64.5 45,66 54,71 Z" />
    <!-- Right page (mirror of the left about x=54) -->
    <path
        android:fillColor="#D4B062"
        android:pathData="M54,45 C63,40 74,38.5 85,41 L85,67 C74,64.5 63,66 54,71 Z" />

    <!-- Spine fold -->
    <path
        android:fillColor="#A07C38"
        android:pathData="M52.5,44.5 L55.5,44.5 L55.5,71.5 L52.5,71.5 Z" />

    <!-- Text lines — left page -->
    <path android:fillColor="#4A3A1C" android:pathData="M29,49.5 L47,51.5 L47,53 L29,51 Z" />
    <path android:fillColor="#4A3A1C" android:pathData="M29,55.5 L45,57.5 L45,59 L29,57 Z" />
    <path android:fillColor="#4A3A1C" android:pathData="M29,61.5 L43,63.5 L43,65 L29,63 Z" />
    <!-- Text lines — right page (mirrored) -->
    <path android:fillColor="#4A3A1C" android:pathData="M79,49.5 L61,51.5 L61,53 L79,51 Z" />
    <path android:fillColor="#4A3A1C" android:pathData="M79,55.5 L63,57.5 L63,59 L79,57 Z" />
    <path android:fillColor="#4A3A1C" android:pathData="M79,61.5 L65,63.5 L65,65 L79,63 Z" />
</vector>
